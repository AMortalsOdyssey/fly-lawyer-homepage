---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleMeta from "@/components/ArticleMeta.astro";
import { buildArticleSchema } from "@/utils/structured-data";

export async function getStaticPaths() {
  const entries = await getCollection("news");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = `/news/${entry.id}/`;
const articleSchema = buildArticleSchema({
  type: "NewsArticle",
  path: canonical,
  title: entry.data.title,
  description: entry.data.summary,
  authors: [{ name: entry.data.editor, type: "Organization" }],
  datePublished: entry.data.pubDate,
  section: entry.data.category,
  keywords: [entry.data.category, "方丽英律师"]
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  canonical={canonical}
  ogType="article"
  publishedTime={entry.data.pubDate.toISOString()}
  structuredData={articleSchema}
>
  <section class="section">
    <div class="container detail-grid">
      <article class="article-shell">
        <span class="article-kicker">{entry.data.category}</span>
        <h1>{entry.data.title}</h1>
        <ArticleMeta creditLabel="编辑整理" credits={[entry.data.editor]} date={entry.data.pubDate} />
        <div class="article-body"><Content /></div>
        {entry.data.sourceUrl && (
          <p class="article-source"><a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">原文来源</a></p>
        )}
      </article>
      <aside class="detail-aside">
        <h2>动态属性</h2>
        <ul class="clean-list">
          <li>类型：{entry.data.category}</li>
          <li>日期：{entry.data.pubDate.toLocaleDateString("zh-CN")}</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
