---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortNews, unique } from "@/utils/content";

const newsItems = sortNews(await getCollection("news"));
const categories = unique(newsItems.map((item) => item.data.category));
---

<BaseLayout title="动态资讯" description="方丽英律师动态资讯、专业活动、荣誉消息与公益普法记录。">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">News</span>
      <h1 class="section-title">动态资讯</h1>
      <p class="section-lead">专业活动、荣誉消息、公益普法与律所动态。</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="filter-bar" data-filter-control="[data-news-card]">
        <button class="active" type="button" data-filter="全部">全部</button>
        {categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}
      </div>
      <div class="list-stack">
        {newsItems.map((item) => (
          <a class="insight-card news-card" href={`/news/${item.id}/`} data-news-card data-category={item.data.category}>
            <div>
              <p class="meta">{item.data.category} · {item.data.pubDate.toLocaleDateString("zh-CN")}</p>
              <h2>{item.data.title}</h2>
              <p>{item.data.summary}</p>
            </div>
            <span class="card-link">阅读动态</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
