---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout
  title="联系广州婚姻家事律师方丽英"
  description="广州婚姻家事律师方丽英的执业信息、联系方式、广东天习律师事务所广州办公地址与官方信息页。"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1 class="section-title">联系我</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="contact-panel">
        <p><strong>律师：</strong>{profile.name}</p>
        <p><strong>执业证号：</strong>{profile.licenseNumber}</p>
        <p><strong>职务：</strong>{profile.title}</p>
        <p><strong>邮箱：</strong><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p><strong>电话：</strong><a href={`tel:${profile.phone}`}>{profile.phone}</a></p>
        <p><strong>律所电话：</strong><a href={`tel:${profile.firmPhone}`}>{profile.firmPhone}</a></p>
        <p><strong>办公地址：</strong>{profile.address}</p>
        <p>
          <strong>律所官方信息页：</strong>
          <a class="text-link" href={profile.officialProfileUrl} target="_blank" rel="noopener noreferrer">查看方丽英律师官方介绍</a>
        </p>
        <p class="contact-disclaimer">{profile.disclaimer}</p>
      </div>
    </div>
  </section>
</BaseLayout>
