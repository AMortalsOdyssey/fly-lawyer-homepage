---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout title="联系我" description="方丽英律师联系方式与律所地址。">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1 class="section-title">联系我</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="contact-panel">
        <p><strong>律师：</strong>{profile.name}</p>
        <p><strong>职务：</strong>{profile.title}</p>
        <p><strong>邮箱：</strong><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p><strong>电话：</strong><a href={`tel:${profile.phone}`}>{profile.phone}</a></p>
        <p><strong>律所电话：</strong><a href={`tel:${profile.firmPhone}`}>{profile.firmPhone}</a></p>
        <p><strong>办公地址：</strong>{profile.address}</p>
      </div>
    </div>
  </section>
</BaseLayout>
