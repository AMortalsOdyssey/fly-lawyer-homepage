---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout title="个人简介" description="方丽英律师个人简介、专业定位、执业资质、行业任职、荣誉奖项与专业活动。">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1 class="section-title">方丽英</h1>
      <p class="section-lead">{profile.positioning}</p>
    </div>
  </section>
  <section class="section">
    <div class="container split-grid">
      <article class="bio-panel">
        <h2>{profile.name}</h2>
        <p>{profile.intro}</p>
        <p>{profile.expertise}</p>
        <p>{profile.approach}</p>
        <p>{profile.principle}</p>
        <h2>六大专业服务板块</h2>
        <div class="tag-row">
          {profile.practiceAreas.map((area) => <span class="tag">{area}</span>)}
        </div>
        <h2 class="clients-heading">服务企业与单位</h2>
        <p>{profile.clients.join("、")}等数十家企业和单位。</p>
      </article>
      <aside class="side-rail">
        <div class="rail-block">
          <h3>执业资格</h3>
          <ul class="clean-list">{profile.qualifications.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="rail-block">
          <h3>社会职务</h3>
          <ul class="clean-list role-list">{profile.roles.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="rail-block">
          <h3>荣誉奖项</h3>
          <ul class="clean-list">{profile.honors.map((item) => <li>{item}</li>)}</ul>
        </div>
      </aside>
    </div>
  </section>
  <section class="section band-white">
    <div class="container">
      <span class="eyebrow">Activities</span>
      <h2 class="section-title">行业任职与专业活动</h2>
      <div class="activity-list">
        {profile.professionalActivities.map((item) => (
          <div class="activity-item">
            <span>{item.year}</span>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
