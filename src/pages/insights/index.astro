---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { INSIGHTS_PER_PAGE, paginate, sortInsights, unique } from "@/utils/content";

const allInsights = sortInsights(await getCollection("insights"));
const pages = paginate(allInsights, INSIGHTS_PER_PAGE);
const pageData = pages[0];
const types = unique(allInsights.map((item) => item.data.type));
---

<BaseLayout title="法律解读" description="方丽英律师法律解读、研究与评论，聚焦婚姻家事、家族财富、金融争议、不良资产与涉外民商事。">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Insights</span>
      <h1 class="section-title">法律解读</h1>
      <p class="section-lead">以解读、研究、评论承接专业观察和办案经验，所有文章均生成独立静态链接。</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="filter-bar" data-filter-control="[data-insight-card]">
        <button class="active" type="button" data-filter="全部">全部</button>
        {types.map((type) => <button type="button" data-filter={type}>{type}</button>)}
      </div>
      <div class="list-stack">
        {pageData.items.map((item) => (
          <a class="insight-card" href={`/insights/${item.id}/`} data-insight-card data-category={item.data.type}>
            <div>
              <p class="meta">{item.data.type} · {item.data.field} · {item.data.pubDate.toLocaleDateString("zh-CN")}</p>
              <h2>{item.data.title}</h2>
              <p>{item.data.summary}</p>
            </div>
            <span class="card-link">阅读</span>
          </a>
        ))}
      </div>
      <nav class="pager" aria-label="文章分页">
        <span class="current">1</span>
        {pages.slice(1).map((page) => <a href={`/insights/page/${page.page}/`}>{page.page}</a>)}
      </nav>
    </div>
  </section>
</BaseLayout>
