---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleMeta from "@/components/ArticleMeta.astro";
import { buildArticleSchema } from "@/utils/structured-data";

export async function getStaticPaths() {
  const entries = await getCollection("cases");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = `/cases/${entry.id}/`;
const articleSchema = buildArticleSchema({
  type: "Article",
  path: canonical,
  title: entry.data.title,
  description: entry.data.summary,
  authors: entry.data.authors.map((name) => ({ name })),
  yearPublished: entry.data.year,
  section: entry.data.field,
  keywords: [entry.data.category, entry.data.field, ...entry.data.focus]
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  canonical={canonical}
  ogType="article"
  structuredData={articleSchema}
>
  <section class="section">
    <div class="container detail-grid">
      <article class="article-shell">
        <span class="article-kicker">{entry.data.category} · {entry.data.field}</span>
        <h1>{entry.data.title}</h1>
        <ArticleMeta creditLabel="案例整理" credits={entry.data.authors} year={entry.data.year} />
        <p class="article-anonymized">{entry.data.anonymized}</p>
        <div class="article-body"><Content /></div>
        {entry.data.sourceUrl && (
          <p class="article-source"><a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">原文来源</a></p>
        )}
      </article>
      <aside class="detail-aside">
        <h2>争议焦点</h2>
        <ul class="clean-list">{entry.data.focus.map((item) => <li>{item}</li>)}</ul>
        <h2>处理要点</h2>
        <ul class="clean-list">{entry.data.handling.map((item) => <li>{item}</li>)}</ul>
      </aside>
    </div>
  </section>
</BaseLayout>
