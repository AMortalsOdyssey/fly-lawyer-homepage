---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CASES_PER_PAGE, paginate, sortCases, unique } from "@/utils/content";

export async function getStaticPaths() {
  const allCases = sortCases(await getCollection("cases"));
  return paginate(allCases, CASES_PER_PAGE).slice(1).map((pageData) => ({
    params: { page: String(pageData.page) },
    props: { pageData, allCases }
  }));
}

const { pageData, allCases } = Astro.props;
const categories = unique(allCases.map((item) => item.data.category));
---

<BaseLayout title={`精选案例 第 ${pageData.page} 页`} description="方丽英律师精选案例分页列表。" canonical={`/cases/page/${pageData.page}/`}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Cases</span>
      <h1 class="section-title">精选案例</h1>
      <p class="section-lead">第 {pageData.page} 页</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="filter-bar" data-filter-control="[data-case-card]">
        <button class="active" type="button" data-filter="全部">全部</button>
        {categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}
      </div>
      <div class="list-stack">
        {pageData.items.map((item) => (
          <a class="case-card" href={`/cases/${item.id}/`} data-case-card data-category={item.data.category}>
            <div>
              <p class="meta">{item.data.category} · {item.data.field}</p>
              <h2>{item.data.title}</h2>
              <p>{item.data.summary}</p>
            </div>
            <span class="card-link">查看案例</span>
          </a>
        ))}
      </div>
      <nav class="pager" aria-label="案例分页">
        <a href="/cases/">1</a>
        {Array.from({ length: pageData.totalPages - 1 }, (_, index) => index + 2).map((page) => (
          page === pageData.page ? <span class="current">{page}</span> : <a href={`/cases/page/${page}/`}>{page}</a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
