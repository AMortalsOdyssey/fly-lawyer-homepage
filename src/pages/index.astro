---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile, siteMeta } from "@/data/profile";
import { sortCases, sortInsights, sortNews, sortPractice } from "@/utils/content";

const practice = sortPractice(await getCollection("practice"));
const cases = sortCases(await getCollection("cases"));
const insights = sortInsights(await getCollection("insights"));
const news = sortNews(await getCollection("news"));
const featuredCases = cases.filter((item) => item.data.featured).slice(0, 4);
const featuredInsights = insights.filter((item) => item.data.featured).slice(0, 3);
const featuredNews = news.filter((item) => item.data.featured).slice(0, 3);
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${siteMeta.domain}/#faq`,
  mainEntity: profile.faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="方丽英｜广州婚姻家事与家族财富传承律师"
  description="方丽英律师个人主页，广州专注婚姻家事与家族财富传承，提供复杂家事纠纷、家企资产隔离、涉外家事与企业家家庭资产安排法律服务。"
  structuredData={faqSchema}
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy" data-reveal>
        {/* H1 里带上城市与业务词：页面与问题的语义匹配度是被引用的最强预测因子（r=0.432，
            高于站点权威度），只写人名等于把首屏最重要的语义位置留空。视觉上仍以姓名为主。 */}
        <h1>{profile.name}<span class="hero-positioning hero-h1-sub">{profile.positioning}</span></h1>
        <p class="hero-role">{profile.title}</p>
        <div class="hero-info">
          <p><span>执业证号</span>{profile.licenseNumber}</p>
          <p><span>电　　话</span><a href={`tel:${profile.phone}`}>{profile.phone}</a></p>
          <p><span>邮　　箱</span><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        </div>
        <div class="hero-field">
          <h2>专业领域</h2>
          <p>{profile.heroPracticeAreas.join("，")}</p>
        </div>
      </div>
      <div class="hero-portrait" data-reveal>
        <img src="/assets/fangliying-portrait.png" alt="方丽英律师职业形象照，婚姻家事与家族财富传承律师" />
      </div>
    </div>
  </section>

  <section class="section band-white">
    <div class="container split-grid">
      <article class="bio-panel" data-reveal>
        <span class="eyebrow">About</span>
        <h2>个人简介</h2>
        <p>{profile.intro}</p>
        <p>{profile.expertise}</p>
        <p>{profile.approach}</p>
        <p>{profile.principle}</p>
        <a class="card-link" href="/about/">查看完整简介</a>
      </article>
      <aside class="side-rail" data-reveal>
        <div class="rail-block">
          <h3>执业资格</h3>
          <ul class="clean-list">
            {profile.qualifications.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="rail-block">
          <h3>社会身份</h3>
          <ul class="clean-list role-list">
            {profile.roles.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="rail-block">
          <h3>荣誉奖项</h3>
          <ul class="clean-list">
            {profile.honors.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section practice-minimal">
    <div class="container">
      <div class="practice-minimal-grid">
        <aside class="practice-minimal-intro" data-reveal>
          <span class="eyebrow">Practice</span>
          <h2 class="section-title">专业领域</h2>
          <p>以婚姻家事与财富传承为主线，为复杂家庭资产、跨境财产与家企风险提供诉讼、调解和规划服务。</p>
        </aside>
        <div class="practice-minimal-list">
          {practice.map((item, index) => (
            <a class="practice-minimal-item" href={`/practice/${item.id}/`} data-reveal>
              <span class="minimal-index">{String(index + 1).padStart(2, "0")}</span>
              <div class="minimal-content">
                <h3>{item.data.shortTitle}</h3>
                <p>{item.data.summary}</p>
                <div class="tag-row">
                  {item.data.keywords.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section band-white">
    <div class="container">
      <span class="eyebrow">Cases</span>
      <h2 class="section-title">代表案例</h2>
      <p class="section-lead">下列案例均已作脱敏处理，涵盖复杂婚姻家事、妇女儿童权益、家企资产隔离及相关综合争议。</p>
      <div class="case-summary-grid">
        {profile.caseGroups.map((group, index) => (
          <article class="case-summary-group" data-reveal>
            <span class="minimal-index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      {featuredCases.length > 0 && (
        <div class="case-detail-block">
          <div class="subsection-heading">
            <h3>精选案例</h3>
            <a class="card-link" href="/cases/">查看全部案例</a>
          </div>
          <div class="list-stack">
            {featuredCases.map((item) => (
              <a class="case-card" href={`/cases/${item.id}/`} data-category={item.data.category} data-reveal>
                <div>
                  <p class="meta">{item.data.category} · {item.data.field}</p>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <span class="card-link">查看案例</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">News</span>
      <h2 class="section-title">行业任职与专业活动</h2>
      <p class="section-lead">持续参与婚姻家事、妇女儿童权益与律师专业化建设，以培训、研讨和行业交流推动实务经验共享。</p>
      <div class="activity-list">
        {profile.professionalActivities.map((item) => (
          <div class="activity-item" data-reveal>
            <span>{item.year}</span>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
      <div class="subsection-heading">
        <h3>动态资讯</h3>
        <a class="card-link" href="/news/">查看全部动态</a>
      </div>
      <div class="list-stack">
        {featuredNews.map((item) => (
          <a class="insight-card news-card" href={`/news/${item.id}/`} data-category={item.data.category} data-reveal>
            <div>
              <p class="meta">{item.data.category} · {item.data.pubDate.toLocaleDateString("zh-CN")}</p>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              <span class="card-link">阅读动态</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Insights</span>
      <h2 class="section-title">专业研究与普法动态</h2>
      <p class="section-lead">{profile.research}</p>
      <div class="list-stack">
        {featuredInsights.map((item) => (
          <a class="insight-card" href={`/insights/${item.id}/`} data-category={item.data.type} data-reveal>
            <div>
              <p class="meta">{item.data.type} · {item.data.field} · {item.data.pubDate.toLocaleDateString("zh-CN")}</p>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
            </div>
            <span class="card-link">阅读</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-white" id="faq">
    <div class="container faq-grid">
      <div class="faq-intro" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2 class="section-title">常见问题</h2>
        <p>以下为常见家事法律问题的一般性说明。具体处理方案仍需结合证据、资产结构和个案事实判断。</p>
      </div>
      <div class="faq-list">
        {profile.faqs.map((item, index) => (
          <details class="faq-item" open={index === 0} data-reveal>
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {item.question}
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight band-white">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h2 class="section-title">联系我</h2>
      </div>
      <div class="contact-panel">
        <p><strong>邮箱：</strong><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p><strong>电话：</strong><a href={`tel:${profile.phone}`}>{profile.phone}</a></p>
        <p><strong>地址：</strong>{profile.address}</p>
        <p class="contact-disclaimer">{profile.disclaimer}</p>
        <a class="button secondary" href="/contact/">查看联系信息</a>
      </div>
    </div>
  </section>
</BaseLayout>
