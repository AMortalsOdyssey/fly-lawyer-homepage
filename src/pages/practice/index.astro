---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortPractice } from "@/utils/content";

const practice = sortPractice(await getCollection("practice"));
const activePractice = practice[0];
const { Content } = await render(activePractice);
---

<BaseLayout title="专业领域" description="方丽英律师六大专业服务板块：婚姻家事诉讼、家事协议与诉前调解、继承与家族财富传承、涉外家事、企业家家事金融衔接及企业法律顾问。">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Practice</span>
      <h1 class="section-title">专业领域</h1>
      <p class="section-lead">从家事诉讼、柔性调解到财富传承、跨境财产与家企风险隔离，提供覆盖家庭资产全周期的法律服务。</p>
    </div>
  </section>

  <section class="practice-section">
    <div class="container practice-container">
      <nav class="practice-breadcrumb" aria-label="当前位置">
        <a href="/">方丽英律师个人主页</a>
        <span>&gt;</span>
        <span>{activePractice.data.title}</span>
      </nav>

      <nav class="practice-tabs" aria-label="专业领域子栏目">
        {practice.map((item) => (
          <a
            class:list={[{ active: item.id === activePractice.id }, "practice-tab"]}
            href={`/practice/${item.id}/`}
            aria-current={item.id === activePractice.id ? "page" : undefined}
          >
            {item.data.shortTitle}
          </a>
        ))}
      </nav>

      <article class="practice-content-panel" aria-labelledby="practice-current-title">
        <h2 id="practice-current-title">{activePractice.data.title}</h2>
        <div class="article-body practice-body"><Content /></div>
      </article>
    </div>
  </section>
</BaseLayout>
