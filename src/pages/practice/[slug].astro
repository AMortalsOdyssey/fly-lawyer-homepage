---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortPractice } from "@/utils/content";

export async function getStaticPaths() {
  const entries = await getCollection("practice");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPractice = sortPractice(await getCollection("practice"));
---

<BaseLayout title={entry.data.title} description={entry.data.summary} canonical={`/practice/${entry.id}/`}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Practice</span>
      <h1 class="section-title">专业领域</h1>
      <p class="section-lead">从家事诉讼、柔性调解到财富传承、跨境财产与家企风险隔离，提供覆盖家庭资产全周期的法律服务。</p>
    </div>
  </section>

  <section class="practice-section">
    <div class="container practice-container">
      <nav class="practice-breadcrumb" aria-label="当前位置">
        <a href="/">方丽英律师个人主页</a>
        <span>&gt;</span>
        <span>{entry.data.title}</span>
      </nav>

      <nav class="practice-tabs" aria-label="专业领域子栏目">
        {allPractice.map((item) => (
          <a
            class:list={[{ active: item.id === entry.id }, "practice-tab"]}
            href={`/practice/${item.id}/`}
            aria-current={item.id === entry.id ? "page" : undefined}
          >
            {item.data.shortTitle}
          </a>
        ))}
      </nav>

      <article class="practice-content-panel" aria-labelledby="practice-current-title">
        <h2 id="practice-current-title">{entry.data.title}</h2>
        <div class="article-body practice-body"><Content /></div>
      </article>
    </div>
  </section>
</BaseLayout>
