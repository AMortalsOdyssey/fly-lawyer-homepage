---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortPractice } from "@/utils/content";

export async function getStaticPaths() {
  const entries = await getCollection("practice");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPractice = sortPractice(await getCollection("practice"));

// 页面上本来就有可见面包屑，这里补上对应的结构化数据，让层级关系对抓取方也成立
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: "https://fangliying.com/" },
    { "@type": "ListItem", position: 2, name: "专业领域", item: "https://fangliying.com/practice/" },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: `https://fangliying.com/practice/${entry.id}/` }
  ]
};
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.seoDescription ?? entry.data.summary}
  canonical={`/practice/${entry.id}/`}
  structuredData={breadcrumbSchema}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">专业领域</span>
      {/* H1 用本页主题词而不是栏目名：6 个子页原来共用「专业领域」这一个 H1，
          等于把最强的语义信号（标题对题）全部浪费掉。 */}
      <h1 class="section-title">{entry.data.title}</h1>
      <p class="section-lead">{entry.data.summary}</p>
    </div>
  </section>

  <section class="practice-section">
    <div class="container practice-container">
      <nav class="practice-breadcrumb" aria-label="当前位置">
        <a href="/">方丽英律师个人主页</a>
        <span>&gt;</span>
        <span>{entry.data.title}</span>
      </nav>

      <nav class="practice-tabs" aria-label="专业领域子栏目">
        {allPractice.map((item) => (
          <a
            class:list={[{ active: item.id === entry.id }, "practice-tab"]}
            href={`/practice/${item.id}/`}
            aria-current={item.id === entry.id ? "page" : undefined}
          >
            {item.data.shortTitle}
          </a>
        ))}
      </nav>

      <article class="practice-content-panel" aria-labelledby="practice-current-title">
        <h2 id="practice-current-title">服务范围与处理要点</h2>
        <div class="article-body practice-body"><Content /></div>
      </article>
    </div>
  </section>
</BaseLayout>
