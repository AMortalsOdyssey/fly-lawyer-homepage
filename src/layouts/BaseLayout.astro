---
import "../styles/global.css";
import { navItems, profile, siteMeta } from "@/data/profile";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteMeta.siteName,
  description = siteMeta.description,
  canonical = Astro.url.pathname,
  image = "/assets/og-cover.jpg",
  ogType = "website",
  publishedTime,
  structuredData
} = Astro.props;

const canonicalUrl = new URL(canonical, siteMeta.domain).toString();
const fullTitle = title === siteMeta.siteName ? title : `${title}｜${siteMeta.siteName}`;
const currentPath = Astro.url.pathname;

const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteMeta.domain}/#person`,
      name: profile.name,
      jobTitle: profile.positioning,
      url: siteMeta.domain,
      image: `${siteMeta.domain}/assets/fangliying-portrait.png`,
      telephone: profile.phone,
      email: profile.email,
      identifier: profile.licenseNumber,
      worksFor: { "@id": `${siteMeta.domain}/#lawfirm` },
      knowsAbout: profile.practiceAreas,
      sameAs: [profile.officialProfileUrl, profile.firmUrl]
    },
    {
      "@type": "LegalService",
      "@id": `${siteMeta.domain}/#lawfirm`,
      name: profile.firm,
      url: profile.firmUrl,
      telephone: profile.firmPhone,
      address: {
        "@type": "PostalAddress",
        streetAddress: profile.address,
        addressLocality: profile.city,
        addressRegion: "广东",
        addressCountry: "CN"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteMeta.domain}/#website`,
      name: siteMeta.siteName,
      url: siteMeta.domain,
      publisher: { "@id": `${siteMeta.domain}/#person` }
    },
    ...pageStructuredData
  ]
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(image, siteMeta.domain).toString()} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#063a9b" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="主导航">
        <a class="brand" href="/" aria-label="方丽英律师个人主页">
          <img src="/assets/tianxi-logo.png" alt="天习律师事务所 Logo" />
          <span class="brand-divider" aria-hidden="true"></span>
          <span class="brand-person">方丽英律师</span>
        </a>
        <button class="nav-toggle" type="button" aria-label="打开主导航" aria-expanded="false" aria-controls="nav-menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-menu" id="nav-menu">
          {navItems.map((item) => (
            <a class:list={[{ active: currentPath.startsWith(item.href) }, "nav-link"]} href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-main">
          <a class="footer-logo-link" href={profile.firmUrl} aria-label="访问广东天习律师事务所官网">
            <img class="footer-logo" src="/assets/tianxi-logo.png" alt="天习律师事务所 Logo" />
          </a>
          <div class="footer-meta">
            <p><span>律师</span><strong>{profile.name}律师</strong></p>
            <p><span>电话</span><a href={`tel:${profile.phone}`}>{profile.phone}</a></p>
            <p><span>邮箱</span><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
            <p><span>地址</span>{profile.address}</p>
          </div>
        </div>
        <div class="footer-legal">
          <div class="footer-records" aria-label="网站备案信息">
            <a class="footer-record-link" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
              {siteMeta.icpRecord}
            </a>
            <a
              class="footer-record-link footer-record-link-police"
              href={`https://beian.mps.gov.cn/#/query/webSearch?code=${siteMeta.publicSecurityRecordCode}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img class="footer-police-badge" src="/assets/beian-police-badge.png" alt="" loading="lazy" />
              <span>{siteMeta.publicSecurityRecord}</span>
            </a>
          </div>
          <p class="footer-copyright">Copyright © 2026 fangliying.com All Rights Reserved.</p>
        </div>
      </div>
    </footer>
    <script>
      const navToggle = document.querySelector(".nav-toggle");
      const navMenu = document.querySelector(".nav-menu");
      navToggle?.addEventListener("click", () => {
        const expanded = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", String(!expanded));
        navToggle.setAttribute("aria-label", expanded ? "打开主导航" : "关闭主导航");
        navMenu?.classList.toggle("open", !expanded);
      });

      const revealItems = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }

      document.querySelectorAll("[data-filter-control]").forEach((group) => {
        const buttons = Array.from(group.querySelectorAll("[data-filter]"));
        const targetSelector = group.getAttribute("data-filter-control");
        const scope = group.closest(".container") || document;
        if (!targetSelector) return;

        const applyFilter = (filter: string | null) => {
          const activeFilter = (filter || "全部").trim();
          const cards = scope.querySelectorAll(targetSelector);

          buttons.forEach((item) => {
            const isActive = item.getAttribute("data-filter") === activeFilter;
            item.classList.toggle("active", isActive);
            item.setAttribute("aria-pressed", String(isActive));
          });

          cards.forEach((card) => {
            const value = (card.getAttribute("data-category") || "").trim();
            const shouldHide = activeFilter !== "全部" && value !== activeFilter;
            card.classList.toggle("filtered-out", shouldHide);
            card.toggleAttribute("hidden", shouldHide);
          });
        };

        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.classList.contains("active")));
          button.addEventListener("click", () => {
            applyFilter(button.getAttribute("data-filter"));
          });
        });
      });
    </script>
    <script is:inline>
      (() => {
        const hostname = window.location.hostname;
        if (!["fangliying.com", "www.fangliying.com"].includes(hostname)) return;
        if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;

        const endpoint = "https://dashboard.8xd.io/api/collect/pageview";
        const sessionKey = "fly_lawyer_pageview_session";
        let sessionId = "";
        try {
          sessionId = sessionStorage.getItem(sessionKey) || crypto.randomUUID();
          sessionStorage.setItem(sessionKey, sessionId);
        } catch {
          sessionId = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
        }

        const payload = JSON.stringify({
          domain: hostname,
          path: window.location.pathname,
          referrer: document.referrer || "",
          eventName: "pageview",
          sessionId
        });
        const blob = new Blob([payload], { type: "text/plain;charset=UTF-8" });

        if (navigator.sendBeacon && navigator.sendBeacon(endpoint, blob)) return;
        fetch(endpoint, {
          method: "POST",
          mode: "cors",
          keepalive: true,
          headers: { "Content-Type": "text/plain;charset=UTF-8" },
          body: payload
        }).catch(() => {});
      })();
    </script>
  </body>
</html>
